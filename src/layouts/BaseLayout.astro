---
import { BRAND } from '@/config/brand';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/archivo/index.css';
import '@/styles/global.css';
import bodoniLatin from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import { themeColors } from '@/styles/themeColors';
import type { ThemeName } from '@/styles/themeColors';
import { BLOCK_INDEXING } from 'astro:env/server';
import { ClientRouter } from 'astro:transitions';
import HreflangLinks from '@/components/HreflangLinks.astro';
import JsonLd from '@/components/JsonLd.astro';
import Seo from '@/components/Seo.astro';
import SkipLink from '@/components/SkipLink.astro';
import type { Locale } from '@/domain/Locale';
import type { Photo } from '@/domain/Photo';
import type { Translations } from '@/domain/Translations';
import { htmlLanguages } from '@/seo/htmlLanguages';
import { resolveSeoImage } from '@/seo/resolveSeoImage';

interface Props {
  title: string;
  description: string;
  theme: ThemeName;
  image?: Photo | undefined;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  home?: boolean;
  locale: Locale;
  alternates: Record<Locale, string>;
  translations?: Translations;
  skipLabel: string;
}

const { title, description, theme, image, jsonLd = [], noindex = false, home = false, locale, alternates, translations = { es: true, en: true, pt: true }, skipLabel } = Astro.props;
const hidden = noindex || BLOCK_INDEXING === 'true';

const themeColor = themeColors[theme];

const fullTitle = home ? title : `${title} — ${BRAND.fullName}`;
const seoImage = image && Astro.site ? await resolveSeoImage(image, Astro.site) : undefined;
---
<!doctype html>
<html lang={htmlLanguages[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={bodoniLatin} as="font" type="font/woff2" crossorigin />
    <Seo title={fullTitle} description={description} image={seoImage} noindex={hidden} locale={locale} alternates={alternates} translations={translations} />
    {translations[locale] && !hidden && Astro.site && <HreflangLinks alternates={alternates} translations={translations} site={Astro.site} />}
    {jsonLd.map((data) => <JsonLd data={data} />)}
    <ClientRouter />
    <script is:inline>
      {
        const arm = () => {
          const root = document.documentElement;
          root.classList.add('js', 'motion-pending');
          setTimeout(() => root.classList.remove('motion-pending'), 2500);
        };
        arm();
        document.addEventListener('astro:after-swap', arm);
      }
    </script>
  </head>
  <body data-theme={theme}>
    <SkipLink label={skipLabel} />
    <slot name="header" />
    <main id="contenido" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<script>
  import { afterLoad } from '@/motion/afterLoad';
  afterLoad(() => import('@/motion/smoothScroll'));
  afterLoad(() => import('@/motion/titleReveal'));
  afterLoad(() => import('@/motion/headerReveal'));
</script>
