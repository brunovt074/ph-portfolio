---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/archivo/index.css';
import '@/styles/global.css';
import bodoniLatin from '../../node_modules/@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import tokensSource from '@/styles/tokens.css?raw';
import SkipLink from '@/components/SkipLink.astro';

interface Props {
  title: string;
  description: string;
  theme: 'ink' | 'paper' | 'sand' | 'eventos' | 'obra';
  ogImage?: string;
  home?: boolean;
}

const { title, description, theme, ogImage, home = false } = Astro.props;

const themeToken: Record<Props['theme'], string> = {
  ink: 'ink',
  paper: 'paper',
  sand: 'sand',
  eventos: 'eventos-bg',
  obra: 'obra-bg',
};

const themeColor = new RegExp(`--${themeToken[theme]}:\\s*(#[0-9A-Fa-f]{6})`).exec(tokensSource)?.[1];

const fullTitle = home ? title : `${title} — Lara Vischi`;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={bodoniLatin} as="font" type="font/woff2" crossorigin />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-theme={theme}>
    <SkipLink />
    <slot name="header" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
