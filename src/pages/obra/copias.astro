---
import FooterNav from '@/components/FooterNav.astro';
import ObraHeader from '@/components/ObraHeader.astro';
import RichText from '@/components/RichText.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetPrintsPage } from '@/application/GetPrintsPage';
import { contentRepository } from '@/infrastructure/container';

const { content, settings } = await new GetPrintsPage(contentRepository).execute();
---
<BaseLayout title="Copias de autor" description={content.lead} theme="obra">
  <ObraHeader slot="header" current="/obra/copias" />
  <section class="section">
    <div class="container">
      <h1 class="t-display"><RichText title={content.title} /></h1>
      <p class="t-lead">{content.lead}</p>
    </div>
  </section>
  <FooterNav slot="footer" settings={settings} logoVariant="obra" />
</BaseLayout>
