---
import FilmGrain from '@/components/obra/FilmGrain.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import RichText from '@/components/RichText.astro';
import SeriesCounter from '@/components/obra/SeriesCounter.astro';
import SeriesNav from '@/components/obra/SeriesNav.astro';
import SeriesPrintsBand from '@/components/obra/SeriesPrintsBand.astro';
import SeriesSequence from '@/components/obra/SeriesSequence.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BuildSeriesSequence } from '@/application/BuildSeriesSequence';
import { GetSeriesPage } from '@/application/GetSeriesPage';
import { ListSeriesSlugs } from '@/application/ListSeriesSlugs';
import { contentRepository } from '@/infrastructure/container';

export async function getStaticPaths() {
  const slugs = await new ListSeriesSlugs(contentRepository).execute();
  return slugs.map((serie) => ({ params: { serie } }));
}

const { serie } = Astro.params;
const { series, previous, next, prints, obra } = await new GetSeriesPage(contentRepository).execute(serie ?? '');
const settings = await contentRepository.getSettings();
const screens = new BuildSeriesSequence().execute(series.photos);
---
<BaseLayout title={series.title} description={series.curatorialLine} theme="obra">
  <Header slot="header" variant="obra" />
  <FilmGrain />
  <section class="series-intro container">
    <p class="t-eyebrow">Serie {series.number} · {series.photos.length} fotografías · {series.years}</p>
    <h1 class="t-display" data-split><RichText title={series.displayTitle} /></h1>
    <p class="t-lead">{series.curatorialText}</p>
  </section>
  <SeriesSequence series={series} screens={screens} />
  <SeriesCounter />
  {prints.length > 0 && <SeriesPrintsBand band={obra.seriesPrintsBand} />}
  <SeriesNav previous={previous} next={next} />
  <FooterNav slot="footer" settings={settings} logoVariant="obra" />
</BaseLayout>

<style>
  .series-intro {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
    padding-block: calc(var(--section-y) * 1.5);
    text-align: center;
  }

  .series-intro .t-lead {
    max-width: 34em;
  }
</style>
