---
import SeriesView from '@/views/SeriesView.astro';
import { ListSeriesSlugs } from '@/application/ListSeriesSlugs';
import { contentRepository } from '@/infrastructure/container';

export async function getStaticPaths() {
  const slugs = await new ListSeriesSlugs(contentRepository).execute('es');
  return slugs.map((serie) => ({ params: { serie } }));
}

const { serie } = Astro.params;
---
<SeriesView locale="es" slug={serie ?? ''} />
