---
import FilmGrain from '@/components/obra/FilmGrain.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import AboutWork from '@/components/obra/AboutWork.astro';
import ObraIntro from '@/components/obra/ObraIntro.astro';
import OpeningFigure from '@/components/obra/OpeningFigure.astro';
import PrintsTeaser from '@/components/obra/PrintsTeaser.astro';
import SeriesIndex from '@/components/obra/SeriesIndex.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetObraPage } from '@/application/GetObraPage';
import { contentRepository } from '@/infrastructure/container';

const { obra, series, settings } = await new GetObraPage(contentRepository).execute();
---
<BaseLayout
  title="Obra"
  description="Obra personal de Sarah Moreau: series fotográficas, una bitácora del paso del tiempo y copias de autor en edición limitada."
  theme="obra"
>
  <Header slot="header" variant="obra" />
  <FilmGrain />
  <OpeningFigure opening={obra.opening} />
  <ObraIntro quote={obra.quote} />
  <SeriesIndex title={obra.seriesTitle} series={series} />
  <AboutWork title={obra.aboutTitle} exhibitionsTitle={obra.exhibitionsTitle} settings={settings} />
  <PrintsTeaser teaser={obra.printsTeaser} />
  <FooterNav
    slot="footer"
    previous={{ label: 'Encargos', href: '/#encargos' }}
    next={{ label: 'Copias de autor', href: '/obra/copias' }}
    settings={settings}
    logoVariant="obra"
  />
</BaseLayout>
