---
import Button from '@/components/Button.astro';
import Header from '@/components/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="Esta página no existe." theme="ink">
  <Header slot="header" />
  <section class="section">
    <div class="container">
      <h1 class="t-display">Esta página no existe</h1>
      <p class="t-lead">Puede que el enlace haya cambiado. Volvé al inicio y seguí desde ahí.</p>
      <Button href="/" variant="secondary">Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>
