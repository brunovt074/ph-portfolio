---
import Button from '@/components/Button.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetSiteSettings } from '@/application/GetSiteSettings';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { pathTo } from '@/domain/routing/pathTo';
import { contentRepository } from '@/infrastructure/container';

const locale = 'es';
const [settings, texts] = await Promise.all([
  new GetSiteSettings(contentRepository).execute(locale),
  new GetSiteTexts(contentRepository).execute(locale),
]);
const alternates = alternatePaths(() => ({ route: 'home' }));
const exits = [
  { label: texts.nav.home, href: pathTo(locale, { route: 'home' }) },
  { label: texts.nav.editorial, href: pathTo(locale, { route: 'editorial' }) },
  { label: texts.nav.retratos, href: pathTo(locale, { route: 'retratos' }) },
  { label: texts.nav.marcas, href: pathTo(locale, { route: 'marcas' }) },
  { label: texts.nav.eventos, href: pathTo(locale, { route: 'eventos' }) },
  { label: texts.nav.obra, href: pathTo(locale, { route: 'obra' }) },
  { label: 'English', href: alternates.en, lang: 'en' },
  { label: 'Português', href: alternates.pt, lang: 'pt' },
];
---
<BaseLayout
  title={texts.seo.notFoundTitle}
  description={texts.seo.notFoundDescription}
  theme="ink"
  noindex
  locale={locale}
  alternates={alternates}
  skipLabel={texts.a11y.skipToContent}
>
  <Header slot="header" locale={locale} texts={texts} alternates={alternates} />
  <section class="section">
    <div class="container not-found">
      <h1 class="t-display" data-split>{texts.notFound.title}</h1>
      <p class="t-lead">{texts.notFound.lead}</p>
      <nav aria-label={texts.a11y.exits}>
        <ul class="not-found-exits">
          {exits.map((exit) => (
            <li><a class="t-h3 not-found-exit" href={exit.href} lang={exit.lang} hreflang={exit.lang}>{exit.label}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <Button href={alternates.es} variant="secondary">{texts.nav.backHome}</Button>
      </div>
    </div>
  </section>
  <FooterNav slot="footer" locale={locale} texts={texts} previous={null} next={null} settings={settings} />
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(24px, 3vw, 40px);
  }

  .not-found-exits {
    display: flex;
    flex-wrap: wrap;
    gap: 8px clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .not-found-exit {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  @media (hover: hover) {
    .not-found-exit:hover {
      color: var(--accent-current);
    }
  }
</style>
