---
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import AboutSection from '@/components/home/AboutSection.astro';
import BrandsTeaser from '@/components/home/BrandsTeaser.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import EditorialStrip from '@/components/home/EditorialStrip.astro';
import EncargosIndex from '@/components/home/EncargosIndex.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import ObraTeaser from '@/components/home/ObraTeaser.astro';
import Ticker from '@/components/home/Ticker.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetHomePage } from '@/application/GetHomePage';
import { contentRepository } from '@/infrastructure/container';

const { home, facets, settings } = await new GetHomePage(contentRepository).execute();
---
<BaseLayout title="Lara Vischi — Fotografía y video" description={home.lead} theme="ink" home>
  <Header slot="header" current="home" />
  <HomeHero home={home} />
  <Ticker items={home.ticker} />
  <AboutSection settings={settings} cta={home.aboutCta} />
  <EncargosIndex home={home} facets={facets} />
  <EditorialStrip photos={home.editorialStrip} />
  <BrandsTeaser home={home} />
  <ObraTeaser home={home} />
  <ContactSection home={home} settings={settings} />
  <FooterNav slot="footer" previous={null} next={{ label: 'Editorial', href: '/editorial' }} settings={settings} />
</BaseLayout>
