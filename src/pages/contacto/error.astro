---
import ContactResult from '@/components/contact/ContactResult.astro';
import { contactValidationMessages } from '@/actions/contactValidationMessages';

export const prerender = false;

const fieldKeys = ['nombre', 'email', 'tipo', 'mensaje', 'copia'] as const;

const fields = (Astro.url.searchParams.get('campos') ?? '').split(',');
const problems = fieldKeys.filter((key) => fields.includes(key)).map((key) => contactValidationMessages[key]);
const lead = problems.length > 0 ? 'No pudimos enviar tu consulta. Revisá estos datos y probá de nuevo.' : contactValidationMessages.unavailable;
---
<ContactResult
  title="No se pudo enviar"
  lead={lead}
  problems={problems}
  backLabel="Volver al formulario"
  backHref="/#contacto"
/>
