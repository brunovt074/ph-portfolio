---
import ContactResult from '@/components/contact/ContactResult.astro';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import { parseLocale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';
import { contentRepository } from '@/infrastructure/container';

export const prerender = false;

const fieldKeys = ['nombre', 'email', 'tipo', 'mensaje', 'copia'] as const;

const idioma = parseLocale(Astro.url.searchParams.get('idioma'));
const texts = await new GetSiteTexts(contentRepository).execute(idioma);

const errorByField = {
  nombre: texts.contact.errorNombre,
  email: texts.contact.errorEmail,
  tipo: texts.contact.errorTipo,
  mensaje: texts.contact.errorMensaje,
  copia: texts.contact.errorCopia,
};

const fields = (Astro.url.searchParams.get('campos') ?? '').split(',');
const problems = fieldKeys.filter((key) => fields.includes(key)).map((key) => errorByField[key]);
const rateLimited = Astro.url.searchParams.get('motivo') === 'limite';
const lead = rateLimited
  ? texts.contact.rateLimited
  : problems.length > 0
    ? texts.contact.errorLead
    : texts.contact.unavailable;
---
<ContactResult
  title={texts.contact.errorTitle}
  lead={lead}
  problems={problems}
  backLabel={texts.contact.backToForm}
  backHref={pathTo(idioma, { route: 'home', hash: 'contacto' })}
  locale={idioma}
/>
