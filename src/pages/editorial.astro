---
import Lightbox from '@/components/Lightbox.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import CoverTriptych from '@/components/facet/CoverTriptych.astro';
import CtaBand from '@/components/facet/CtaBand.astro';
import FacetIntro from '@/components/facet/FacetIntro.astro';
import MasonryGallery from '@/components/facet/MasonryGallery.astro';
import ServiceColumns from '@/components/facet/ServiceColumns.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetFacetPage } from '@/application/GetFacetPage';
import { contentRepository } from '@/infrastructure/container';

const contactHref = '/?tipo=editorial#contacto';
const { facet, previous, next, settings } = await new GetFacetPage(contentRepository).execute('editorial');
---
<BaseLayout
  title={`${facet.name}`}
  description="Campañas, lookbooks y books de modelo con dirección de arte, de la idea a la imagen retocada. Fotografía editorial y de moda por Sarah Moreau."
  theme="ink"
>
  <Header slot="header" current="editorial" ctaLabel="Reservar sesión" ctaHref={contactHref} />
  <FacetIntro facet={facet} />
  <CoverTriptych photos={facet.cover} />
  <section class="container section" data-gallery="horizontal">
    <MasonryGallery photos={facet.gallery} horizontal />
  </section>
  <ServiceColumns title="Servicios" services={facet.services} numerals="roman" />
  <CtaBand title={facet.ctaText} buttonLabel={facet.ctaButton} href={contactHref} theme="accent" />
  <Lightbox />
  <FooterNav slot="footer" previous={previous} next={next} settings={settings} />
</BaseLayout>
