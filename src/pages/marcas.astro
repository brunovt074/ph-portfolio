---
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import BeforeAfterSection from '@/components/brands/BeforeAfterSection.astro';
import BrandsHero from '@/components/brands/BrandsHero.astro';
import MoreWork from '@/components/brands/MoreWork.astro';
import PackagesSection from '@/components/brands/PackagesSection.astro';
import ProcessSteps from '@/components/brands/ProcessSteps.astro';
import SectorCards from '@/components/brands/SectorCards.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetBrandsPage } from '@/application/GetBrandsPage';
import { contentRepository } from '@/infrastructure/container';

const { facet, brands, previous, next, settings } = await new GetBrandsPage(contentRepository).execute();
---
<BaseLayout
  title="Fotografía para marcas"
  description="Fotografía de producto, gastronomía, joyería y espacios para tu tienda online, tus redes y tus campañas. Pedí tu presupuesto."
  theme="sand"
  image={facet.cover[0]}
>
  <Header slot="header" current="marcas" ctaLabel={brands.headerCta} ctaHref="/?tipo=marcas#contacto" />
  <BrandsHero facet={facet} />
  <SectorCards title={brands.sectorsTitle} sectors={brands.sectors} />
  <MoreWork title={brands.moreWorkTitle} photos={facet.gallery} />
  <BeforeAfterSection title={brands.beforeAfterTitle} lead={brands.beforeAfterLead} pairs={brands.beforeAfter} />
  <ProcessSteps title={brands.processTitle} steps={brands.steps} />
  <PackagesSection title={brands.packagesTitle} cta={brands.packagesCta} packages={brands.packages} />
  <FooterNav slot="footer" previous={previous} next={next} settings={settings} />
</BaseLayout>
