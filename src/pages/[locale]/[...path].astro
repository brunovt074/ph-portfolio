---
import type { GetStaticPaths } from 'astro';
import { ListSeriesSlugs } from '@/application/ListSeriesSlugs';
import type { Locale } from '@/domain/Locale';
import { localizedPaths } from '@/domain/routing/localizedPaths';
import { contentRepository } from '@/infrastructure/container';
import { views } from '@/views/views';
import type { ViewRouteKey } from '@/views/views';

export const getStaticPaths = (async () => {
  const targets: Locale[] = ['en', 'pt'];
  const pages = await Promise.all(
    targets.map(async (locale) => {
      const slugs = await new ListSeriesSlugs(contentRepository).execute(locale);
      return localizedPaths(locale, slugs)
        .filter((entry) => entry.route !== 'reservas')
        .map((entry) => ({
          params: { locale, path: entry.route === 'home' ? undefined : entry.path.slice(`/${locale}/`.length) },
          props: { route: entry.route as ViewRouteKey, slug: entry.slug ?? '' },
        }));
    }),
  );
  return pages.flat();
}) satisfies GetStaticPaths;

const { locale } = Astro.params;
const { route, slug } = Astro.props;
const View = views[route];
---
<View locale={locale as Locale} slug={slug} />
