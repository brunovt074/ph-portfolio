---
import FilmGrain from '@/components/obra/FilmGrain.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import RichText from '@/components/RichText.astro';
import PrintCard from '@/components/obra/PrintCard.astro';
import PrintInfoBand from '@/components/obra/PrintInfoBand.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetPrintsPage } from '@/application/GetPrintsPage';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { pathTo } from '@/domain/routing/pathTo';
import type { Locale } from '@/domain/Locale';
import { contentRepository } from '@/infrastructure/container';
import { buildPrintsSchema } from '@/seo/structuredData';
import ContactForm from '@/components/home/ContactForm.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const texts = await new GetSiteTexts(contentRepository).execute(locale);
const alternates = alternatePaths(() => ({ route: 'copias' }));
const { prints, content, settings } = await new GetPrintsPage(contentRepository).execute(locale);
const copyTitles = prints.map((print) => print.photo.title ?? texts.pages.untitled);
const jsonLd = prints.length > 0 ? [await buildPrintsSchema(prints, Astro.site!, texts, locale)] : [];
---
<BaseLayout
  locale={locale}
  alternates={alternates}
  translations={content.translations}
  skipLabel={texts.a11y.skipToContent}
  title={texts.seo.copiasTitle}
  description={content.lead}
  theme="obra"
  image={prints[2]?.photo ?? prints[0]?.photo}
  jsonLd={jsonLd}
>
  <Header slot="header" locale={locale} texts={texts} alternates={alternates} variant="obra" current="copias" />
  <FilmGrain />
  <section class="prints-intro container">
    <h1 class="t-display" data-split><RichText title={content.title} /></h1>
    <p class="t-lead">{content.lead}</p>
  </section>
  <section class="prints-grid container" aria-label={texts.a11y.availablePrints}>
    {prints.map((print, index) => <PrintCard locale={locale} texts={texts.pages} print={print} cta={content.cta} editionLabel={content.editionLabel} priority={index === 0} />)}
  </section>
  <PrintInfoBand items={content.info} label={texts.a11y.aboutPrints} />
  <section id="consulta" class="print-inquiry section" aria-labelledby="consulta-title">
    <div class="container print-inquiry-grid">
      <h2 id="consulta-title" class="t-display">{texts.pages.printsInquiryTitle}</h2>
      <ContactForm locale={locale} texts={texts.contact} variant="copia" copies={copyTitles} idPrefix="consulta" submitLabel={texts.pages.printsInquirySubmit} />
    </div>
  </section>
  <FooterNav slot="footer" locale={locale} texts={texts} previous={{ label: texts.nav.obra, href: pathTo(locale, { route: 'obra' }) }} next={null} settings={settings} logoVariant="obra" />
</BaseLayout>

<style>
  .prints-intro {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    padding-block: calc(var(--section-y) * 1.25) calc(var(--section-y) * 0.75);
  }

  .prints-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(32px, 4vw, 64px);
    padding-bottom: calc(var(--section-y) * 1.5);
  }

  .print-inquiry {
    border-top: 1px solid var(--line);
  }

  .print-inquiry-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }

  @media (min-width: 900px) {
    .print-inquiry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(40px, 6vw, 96px);
    }
  }
</style>
