---
import Lightbox from '@/components/Lightbox.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import FacetIntro from '@/components/facet/FacetIntro.astro';
import GridGallery from '@/components/facet/GridGallery.astro';
import QuoteBand from '@/components/facet/QuoteBand.astro';
import ServiceColumns from '@/components/facet/ServiceColumns.astro';
import StaggeredPair from '@/components/facet/StaggeredPair.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetFacetPage } from '@/application/GetFacetPage';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import type { Locale } from '@/domain/Locale';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { pathTo } from '@/domain/routing/pathTo';
import { getBookingCatalog } from '@/infrastructure/getBookingCatalog';
import { contentRepository } from '@/infrastructure/container';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const texts = await new GetSiteTexts(contentRepository).execute(locale);
const { facet, previous, next, settings } = await new GetFacetPage(contentRepository).execute(locale, 'retratos');
const { offers } = await getBookingCatalog().listBookingOffers.execute(locale);
const bookingHref = pathTo(locale, { route: 'reservas' });
const bookingLinks = Object.fromEntries(
  offers
    .filter((offer) => offer.bookable)
    .map((offer) => [offer.title, pathTo(locale, { route: 'reservas', query: { sesion: offer.slug }, hash: 'reserva' })]),
);
const alternates = alternatePaths(() => ({ route: 'retratos' }));
---
<BaseLayout
  title={facet.name}
  description={texts.seo.retratosDescription}
  theme="paper"
  image={facet.cover[0]}
  locale={locale}
  translations={facet.translations}
  alternates={alternates}
  skipLabel={texts.a11y.skipToContent}
>
  <Header slot="header" locale={locale} texts={texts} alternates={alternates} current="retratos" ctaLabel={texts.nav.bookSession} ctaHref={bookingHref} />
  <FacetIntro facet={facet} split>
    <StaggeredPair photos={facet.cover} />
  </FacetIntro>
  <section class="container section">
    <GridGallery photos={facet.gallery} ratio="3/4" />
  </section>
  <ServiceColumns title={texts.pages.sessions} services={facet.services} numerals="none" bookingLinks={bookingLinks} bookingLabel={texts.booking.serviceBookLabel} investmentLabel={texts.pages.investment} />
  {facet.quote && <QuoteBand quote={facet.quote} buttonLabel={facet.ctaButton} href={bookingHref} />}
  <Lightbox texts={texts.a11y} />
  <FooterNav slot="footer" previous={previous} next={next} settings={settings} locale={locale} texts={texts} />
</BaseLayout>
