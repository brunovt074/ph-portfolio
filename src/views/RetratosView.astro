---
import Lightbox from '@/components/Lightbox.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import FacetIntro from '@/components/facet/FacetIntro.astro';
import GridGallery from '@/components/facet/GridGallery.astro';
import QuoteBand from '@/components/facet/QuoteBand.astro';
import ServiceColumns from '@/components/facet/ServiceColumns.astro';
import StaggeredPair from '@/components/facet/StaggeredPair.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetFacetPage } from '@/application/GetFacetPage';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { pathTo } from '@/domain/routing/pathTo';
import type { Locale } from '@/domain/Locale';
import { contentRepository } from '@/infrastructure/container';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const texts = await new GetSiteTexts(contentRepository).execute(locale);
const alternates = alternatePaths(() => ({ route: 'retratos' }));
const contactHref = pathTo(locale, { route: 'home', query: { tipo: 'retratos' }, hash: 'contacto' });
const { facet, previous, next, settings } = await new GetFacetPage(contentRepository).execute(locale, 'retratos');
---
<BaseLayout
  locale={locale}
  alternates={alternates}
  translations={facet.translations}
  skipLabel={texts.a11y.skipToContent}
  title={facet.name}
  description={texts.seo.retratosDescription}
  theme="paper"
  image={facet.cover[0]}
>
  <Header slot="header" locale={locale} texts={texts} alternates={alternates} current="retratos" ctaLabel={texts.nav.bookSession} ctaHref={contactHref} />
  <FacetIntro facet={facet} split>
    <StaggeredPair photos={facet.cover} />
  </FacetIntro>
  <section class="container section">
    <GridGallery photos={facet.gallery} texts={texts.pages} ratio="3/4" />
  </section>
  <ServiceColumns title={texts.pages.sessions} texts={texts.pages} services={facet.services} numerals="none" />
  {facet.quote && <QuoteBand quote={facet.quote} buttonLabel={facet.ctaButton} href={contactHref} />}
  <Lightbox texts={texts.a11y} />
  <FooterNav slot="footer" locale={locale} texts={texts} previous={previous} next={next} settings={settings} />
</BaseLayout>

