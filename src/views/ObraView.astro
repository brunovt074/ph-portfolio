---
import FilmGrain from '@/components/obra/FilmGrain.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import AboutWork from '@/components/obra/AboutWork.astro';
import ObraIntro from '@/components/obra/ObraIntro.astro';
import OpeningFigure from '@/components/obra/OpeningFigure.astro';
import PrintsTeaser from '@/components/obra/PrintsTeaser.astro';
import SeriesIndex from '@/components/obra/SeriesIndex.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetObraPage } from '@/application/GetObraPage';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import type { Locale } from '@/domain/Locale';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { pathTo } from '@/domain/routing/pathTo';
import { contentRepository } from '@/infrastructure/container';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const texts = await new GetSiteTexts(contentRepository).execute(locale);
const { obra, series, settings } = await new GetObraPage(contentRepository).execute(locale);
const alternates = alternatePaths(() => ({ route: 'obra' }));
---
<BaseLayout
  title={texts.nav.obra}
  description={texts.seo.obraDescription}
  theme="obra"
  image={obra.opening.photo}
  locale={locale}
  translations={obra.translations}
  alternates={alternates}
  skipLabel={texts.a11y.skipToContent}
>
  <Header slot="header" variant="obra" locale={locale} texts={texts} alternates={alternates} />
  <FilmGrain />
  <OpeningFigure opening={obra.opening} />
  <ObraIntro quote={obra.quote} title={texts.nav.obra} />
  <SeriesIndex title={obra.seriesTitle} series={series} locale={locale} texts={texts} />
  <AboutWork title={obra.aboutTitle} exhibitionsTitle={obra.exhibitionsTitle} settings={settings} />
  <PrintsTeaser teaser={obra.printsTeaser} locale={locale} />
  <FooterNav
    slot="footer"
    previous={{ label: texts.nav.encargos, href: pathTo(locale, { route: 'home', hash: 'encargos' }) }}
    next={{ label: texts.nav.copias, href: pathTo(locale, { route: 'copias' }) }}
    settings={settings}
    locale={locale}
    texts={texts}
    logoVariant="obra"
  />
</BaseLayout>
