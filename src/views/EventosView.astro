---
import Lightbox from '@/components/Lightbox.astro';
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import Ticker from '@/components/Ticker.astro';
import CtaBand from '@/components/facet/CtaBand.astro';
import DenseGallery from '@/components/facet/DenseGallery.astro';
import FacetIntro from '@/components/facet/FacetIntro.astro';
import ServiceColumns from '@/components/facet/ServiceColumns.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetFacetPage } from '@/application/GetFacetPage';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import type { Locale } from '@/domain/Locale';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { pathTo } from '@/domain/routing/pathTo';
import { contentRepository } from '@/infrastructure/container';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const texts = await new GetSiteTexts(contentRepository).execute(locale);
const { facet, previous, next, settings } = await new GetFacetPage(contentRepository).execute(locale, 'eventos');
const contactHref = pathTo(locale, { route: 'home', query: { tipo: 'eventos' }, hash: 'contacto' });
const tickerWords = texts.pages.eventsTicker.split(', ').map((word) => word.trim());
const alternates = alternatePaths(() => ({ route: 'eventos' }));
---
<BaseLayout
  title={facet.name}
  description={texts.seo.eventosDescription}
  theme="eventos"
  image={facet.cover[0]}
  locale={locale}
  translations={facet.translations}
  alternates={alternates}
  skipLabel={texts.a11y.skipToContent}
>
  <Header slot="header" locale={locale} texts={texts} alternates={alternates} current="eventos" ctaLabel={facet.ctaButton} ctaHref={contactHref} />
  <FacetIntro facet={facet} />
  <section class="container">
    <DenseGallery photos={facet.gallery} />
  </section>
  <div class="events-ticker">
    <Ticker items={tickerWords} label={tickerWords.join(', ')} />
  </div>
  <ServiceColumns title={texts.pages.services} services={facet.services} numerals="roman" investmentLabel={texts.pages.investment} />
  <CtaBand title={facet.ctaText} buttonLabel={facet.ctaButton} href={contactHref} theme="lime" />
  <Lightbox texts={texts.a11y} />
  <FooterNav slot="footer" previous={previous} next={next} settings={settings} locale={locale} texts={texts} />
</BaseLayout>

<style>
  .events-ticker {
    margin-top: var(--section-y);
  }
</style>
