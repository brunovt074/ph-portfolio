---
interface Props {
  variant?: 'default' | 'obra';
  href?: string;
}

const { variant = 'default', href } = Astro.props;
const target = href ?? (variant === 'obra' ? '/obra' : '/');
const label = variant === 'obra' ? 'Lara Vischi — obra' : 'Lara Vischi — inicio';
---
<a class="logo" href={target} aria-label={label}>
  Lara <em>Vischi</em>{variant === 'obra' && <span class="logo-suffix"> / obra</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display);
    font-size: var(--text-logo);
    letter-spacing: var(--tracking-logo);
    font-weight: 400;
    white-space: pre;
    color: inherit;
    text-decoration: none;
  }

  .logo em {
    font-style: italic;
  }

  .logo-suffix {
    color: var(--obra-muted);
  }
</style>
