---
import type { Locale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  variant?: 'default' | 'obra';
  href?: string;
  locale: Locale;
  texts: SiteTexts;
}

const { variant = 'default', href, locale, texts } = Astro.props;
const target = href ?? (variant === 'obra' ? pathTo(locale, { route: 'obra' }) : pathTo(locale, { route: 'home' }));
const label = variant === 'obra' ? texts.nav.logoObra : texts.nav.logoHome;
---
<a class="logo" href={target} aria-label={label}>
  Lara <em>Vischi</em>{variant === 'obra' && <span class="logo-suffix"> / {texts.nav.obra}</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display);
    font-size: var(--text-logo);
    letter-spacing: var(--tracking-logo);
    font-weight: 400;
    white-space: pre;
    color: inherit;
    text-decoration: none;
  }

  .logo em {
    font-style: italic;
  }

  .logo-suffix {
    color: var(--obra-muted);
  }
</style>
