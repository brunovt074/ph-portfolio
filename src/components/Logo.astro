---
import type { Locale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  variant?: 'default' | 'obra';
  locale: Locale;
  texts: SiteTexts['nav'];
}

const { variant = 'default', locale, texts } = Astro.props;
const target = pathTo(locale, { route: variant === 'obra' ? 'obra' : 'home' });
const label = variant === 'obra' ? texts.logoObra : texts.logoHome;
---
<a class="logo" href={target} aria-label={label}>
  Sarah <em>Moreau</em>{variant === 'obra' && <span class="logo-suffix"> / {texts.obra.toLowerCase()}</span>}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display);
    font-size: var(--text-logo);
    letter-spacing: var(--tracking-logo);
    font-weight: 500;
    font-optical-sizing: none;
    font-variation-settings: "opsz" 11;
    white-space: pre;
    color: inherit;
    text-decoration: none;
  }

  .logo em {
    font-style: italic;
  }

  .logo-suffix {
    color: var(--obra-muted);
  }
</style>
