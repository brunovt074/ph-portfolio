---
import IndexRow from './IndexRow.astro';
import RichText from '@/components/RichText.astro';
import type { Facet } from '@/domain/Facet';
import type { HomeContent } from '@/domain/HomeContent';
import type { Locale } from '@/domain/Locale';

interface Props {
  home: HomeContent;
  facets: Facet[];
  locale: Locale;
}

const { home, facets, locale } = Astro.props;
---
<section id="encargos" class="section" aria-labelledby="encargos-title">
  <div class="container">
    <header class="encargos-head">
      <span class="t-eyebrow">{home.encargosEyebrow}</span>
      <h2 id="encargos-title" class="t-h2"><RichText title={home.encargosTitle} /></h2>
    </header>
    <ol class="encargos-list" data-index-list>
      {facets.map((facet) => (
        <IndexRow facet={facet} thumbnails={home.facetThumbnails[facet.slug] ?? []} locale={locale} />
      ))}
    </ol>
  </div>
</section>

<style>
  .encargos-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(32px, 5vw, 72px);
  }

  .encargos-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.cursor-preview) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: clamp(200px, 18vw, 300px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.cursor-preview img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { afterLoad } from '@/motion/afterLoad';
  afterLoad(() => import('@/motion/cursorPreview'));
</script>
