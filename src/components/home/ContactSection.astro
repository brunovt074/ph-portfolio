---
import ContactForm from './ContactForm.astro';
import type { HomeContent } from '@/domain/HomeContent';
import type { Locale } from '@/domain/Locale';
import type { SiteSettings } from '@/domain/SiteSettings';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  home: HomeContent;
  settings: SiteSettings;
  texts: SiteTexts['contact'];
  a11y: SiteTexts['a11y'];
  locale: Locale;
}

const { home, settings, texts, a11y, locale } = Astro.props;

const digits = (value: string) => value.replace(/\D/g, '');
const isPlaceholder = (value: string) => value.startsWith('[');
const instagramUrl = (account: string) => `https://instagram.com/${account.replace(/^@/, '')}`;

const channels = [
  { label: texts.channelEmail, entries: [{ text: settings.email, href: isPlaceholder(settings.email) ? undefined : `mailto:${settings.email}` }] },
  { label: texts.channelWhatsapp, entries: [{ text: settings.whatsapp, href: isPlaceholder(settings.whatsapp) ? undefined : `https://wa.me/${digits(settings.whatsapp)}` }] },
  { label: texts.channelInstagram, entries: settings.instagram.map((account) => ({ text: account, href: isPlaceholder(account) ? undefined : instagramUrl(account) })) },
];
---
<section id="contacto" class="contact section" data-theme="surface" aria-labelledby="contacto-title">
  <div class="container contact-grid">
    <h2 id="contacto-title" class="t-display contact-title">{home.contactTitle}</h2>
    <p class="t-lead contact-lead">{home.contactLead}</p>
    <div class="contact-form-area">
      <ContactForm workTypes={home.workTypes} locale={locale} texts={texts} />
    </div>
    <dl class="contact-list">
      {channels.map((channel) => (
        <div class="contact-row">
          <dt class="t-eyebrow">{channel.label}</dt>
          <dd>
            {channel.entries.map((entry) => {
              if (!entry.href) {
                return <span class="contact-text">{entry.text}</span>;
              }
              const external = entry.href.startsWith('http');
              return (
                <a class="contact-link" href={entry.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                  {entry.text}
                  {external && <span class="sr-only"> {a11y.opensInNewTab}</span>}
                </a>
              );
            })}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'lead'
      'form'
      'list';
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }

  .contact-title {
    grid-area: title;
    margin-bottom: clamp(8px, 2vw, 32px);
  }

  .contact-lead {
    grid-area: lead;
  }

  .contact-form-area {
    grid-area: form;
  }

  .contact-list {
    grid-area: list;
    margin: 0;
  }

  .contact-row {
    display: grid;
    grid-template-columns: minmax(96px, 1fr) 3fr;
    align-items: baseline;
    gap: 8px 16px;
    padding-block: 8px;
    border-top: 1px solid var(--line);
  }

  .contact-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .contact-row dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin: 0;
  }

  .contact-link,
  .contact-text {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--fg);
    text-decoration: none;
  }

  .contact-link {
    transition: color 200ms;
  }

  .contact-text {
    color: var(--fg-soft);
  }

  @media (hover: hover) {
    .contact-link:hover {
      color: var(--accent-current);
    }
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'title title'
        'lead form'
        'list form';
      column-gap: clamp(40px, 6vw, 96px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>
