---
interface Props {
  items: string[];
}

const { items } = Astro.props;
const copies = [false, true];
---
<div class="ticker" data-ticker>
  <div class="ticker-track">
    {copies.map((hidden) => (
      <ul class="ticker-sequence" aria-hidden={hidden ? 'true' : undefined}>
        {items.map((item) => (
          <li class="ticker-item t-h3">
            <em>{item}</em>
            <span class="ticker-mark" aria-hidden="true">✦</span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    padding-block: 18px;
    border-block: 1px solid var(--line);
  }

  .ticker-track {
    display: flex;
    width: max-content;
  }

  .ticker-sequence {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker-item {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .ticker-mark {
    padding-inline: clamp(20px, 3vw, 40px);
    color: var(--accent-current);
    font-family: var(--font-body);
    font-size: 0.6em;
  }
</style>
