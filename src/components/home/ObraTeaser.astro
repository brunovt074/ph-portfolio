---
import Photo from '@/components/Photo.astro';
import RichText from '@/components/RichText.astro';
import type { HomeContent } from '@/domain/HomeContent';

interface Props {
  home: HomeContent;
}

const { home } = Astro.props;
const ratios = ['3/4', '4/5', '1/1', '3/4'];
---
<section class="obra-teaser section" data-theme="obra" aria-labelledby="obra-title">
  <div class="container">
    <div class="obra-head">
      <h2 id="obra-title" class="t-display"><RichText title={home.obraTeaserTitle} /></h2>
      <div class="obra-side">
        <p class="t-lead">{home.obraTeaserLead}</p>
        <a class="t-nav obra-link" href="/obra">{home.obraTeaserCta} <span class="obra-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="obra-grid" data-reveal="darkroom">
      {home.obraTeaserPhotos.slice(0, 4).map((photo, index) => (
        <figure class="obra-figure">
          <Photo photo={photo} ratio={ratios[index] ?? '3/4'} sizes="(min-width: 768px) 25vw, 50vw" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .obra-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px clamp(24px, 4vw, 64px);
    margin-bottom: clamp(32px, 5vw, 72px);
  }

  .obra-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: 32ch;
  }

  .obra-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    color: var(--accent-current);
    text-decoration: none;
    transition: color 200ms;
  }

  .obra-arrow {
    display: inline-block;
    transition: transform 200ms;
  }

  @media (hover: hover) {
    .obra-link:hover {
      color: var(--fg);
    }

    .obra-link:hover .obra-arrow {
      transform: translateX(6px);
    }
  }

  .obra-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: end;
    gap: var(--gap-photo);
  }

  .obra-figure {
    margin: 0;
  }

  @media (min-width: 768px) {
    .obra-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .obra-link,
    .obra-arrow {
      transition: none;
    }
  }
</style>
