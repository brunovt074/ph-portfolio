---
import Arrow from '@/components/Arrow.astro';
import Button from '@/components/Button.astro';
import Photo from '@/components/Photo.astro';
import RichText from '@/components/RichText.astro';
import type { HomeContent } from '@/domain/HomeContent';
import type { Locale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';

interface Props {
  locale: Locale;
  home: HomeContent;
}

const { locale, home } = Astro.props;
const ratios = ['3/4', '4/5', '1/1', '3/4'];
---
<section class="obra-teaser section" data-theme="obra" aria-labelledby="obra-title">
  <div class="container">
    <div class="obra-head">
      <h2 id="obra-title" class="t-display"><RichText title={home.obraTeaserTitle} /></h2>
      <div class="obra-side">
        <p class="t-lead">{home.obraTeaserLead}</p>
        <Button href={pathTo(locale, { route: 'obra' })} variant="secondary">{home.obraTeaserCta}&nbsp;<Arrow direction="right" /></Button>
      </div>
    </div>
    <div class="obra-grid" data-reveal="darkroom">
      {home.obraTeaserPhotos.slice(0, 4).map((photo, index) => (
        <figure class="obra-figure">
          <Photo photo={photo} ratio={ratios[index] ?? '3/4'} sizes="(min-width: 768px) 25vw, 50vw" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .obra-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px clamp(24px, 4vw, 64px);
    margin-bottom: clamp(32px, 5vw, 72px);
  }

  .obra-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 32ch;
  }

  .obra-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: end;
    gap: var(--gap-photo);
  }

  .obra-figure {
    margin: 0;
  }

  @media (min-width: 768px) {
    .obra-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
