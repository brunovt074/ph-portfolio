---
import Button from '@/components/Button.astro';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  texts: SiteTexts['contact'];
  workTypes?: string[];
  variant?: 'general' | 'copia';
  copies?: string[];
  idPrefix?: string;
  submitLabel?: string;
}

const { texts, workTypes = [], variant = 'general', copies = [], idPrefix = 'contacto', submitLabel = texts.submit } = Astro.props;
const isCopyInquiry = variant === 'copia';
const tipoByQuery: Record<string, string> = {
  editorial: texts.workTypeEditorial,
  retratos: texts.workTypeRetratos,
  marcas: texts.workTypeMarcas,
  eventos: texts.workTypeEventos,
};
---
<form
  class="contact-form"
  method="post"
  action="/contacto/enviar"
  data-contact-form
  data-variant={variant}
  data-tipos={JSON.stringify(tipoByQuery)}
>
  <div class="field">
    <label class="t-eyebrow" for={`${idPrefix}-nombre`}>{texts.name}<span aria-hidden="true"> *</span></label>
    <input id={`${idPrefix}-nombre`} name="nombre" type="text" required minlength="2" maxlength="80" autocomplete="name" aria-describedby={`${idPrefix}-nombre-error`} />
    <p class="field-error" id={`${idPrefix}-nombre-error`} data-error-for="nombre" hidden></p>
  </div>
  <div class="field">
    <label class="t-eyebrow" for={`${idPrefix}-email`}>{texts.email}<span aria-hidden="true"> *</span></label>
    <input id={`${idPrefix}-email`} name="email" type="email" required autocomplete="email" aria-describedby={`${idPrefix}-email-error`} />
    <p class="field-error" id={`${idPrefix}-email-error`} data-error-for="email" hidden></p>
  </div>
  {isCopyInquiry ? (
    <>
      <input type="hidden" name="tipo" value="Copia de autor" />
      <div class="field">
        <label class="t-eyebrow" for={`${idPrefix}-copia`}>{texts.copy}<span aria-hidden="true"> *</span></label>
        <select id={`${idPrefix}-copia`} name="copia" required aria-describedby={`${idPrefix}-copia-error`}>
          <option value="">{texts.chooseCopy}</option>
          {copies.map((copy) => <option value={copy}>{copy}</option>)}
        </select>
        <p class="field-error" id={`${idPrefix}-copia-error`} data-error-for="copia" hidden></p>
      </div>
    </>
  ) : (
    <div class="field">
      <label class="t-eyebrow" for={`${idPrefix}-tipo`}>{texts.workType}</label>
      <select id={`${idPrefix}-tipo`} name="tipo" aria-describedby={`${idPrefix}-tipo-error`}>
        <option value="">{texts.chooseOption}</option>
        {workTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
      <p class="field-error" id={`${idPrefix}-tipo-error`} data-error-for="tipo" hidden></p>
    </div>
  )}
  <div class="field">
    <label class="t-eyebrow" for={`${idPrefix}-mensaje`}>{texts.message}<span aria-hidden="true"> *</span></label>
    <textarea id={`${idPrefix}-mensaje`} name="mensaje" rows="5" required minlength="10" maxlength="2000" aria-describedby={`${idPrefix}-mensaje-error`}></textarea>
    <p class="field-error" id={`${idPrefix}-mensaje-error`} data-error-for="mensaje" hidden></p>
  </div>
  <div class="trap" aria-hidden="true">
    <label for={`${idPrefix}-sitio-web`}>Sitio web</label>
    <input id={`${idPrefix}-sitio-web`} name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div>
    <p class="required-note">{texts.requiredNote}</p>
    <Button type="submit" variant="primary">{submitLabel}</Button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.5vw, 32px);
  }

  .required-note {
    margin: 0;
    font-size: 13px;
    color: var(--fg-muted);
    margin-bottom: 12px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field-error,
  .form-status {
    margin: 0;
    color: var(--accent-current);
  }

  .form-status {
    margin-top: 16px;
  }

  .form-status:empty {
    display: none;
  }

  .form-status[data-state='success'] {
    color: var(--fg);
  }

  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-body);
    font-size: var(--text-body);
    transition: border-color 200ms;
  }

  input[aria-invalid='true'],
  select[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-bottom-color: var(--accent-current);
  }

  select option {
    background: var(--bg);
    color: var(--fg);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-bottom-color: var(--accent-current);
  }

  @media (prefers-reduced-motion: reduce) {
    input,
    select,
    textarea {
      transition: none;
    }
  }
</style>

<script>
  import { afterLoad } from '@/motion/afterLoad';

  const startForms = () => import('@/forms/initContactForms').then(({ initContactForms }) => initContactForms());

  afterLoad(startForms);
  document.addEventListener('astro:page-load', startForms);
</script>
