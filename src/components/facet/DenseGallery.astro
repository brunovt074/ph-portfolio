---
import Photo from '@/components/Photo.astro';
import type { Photo as PhotoModel } from '@/domain/Photo';

interface Props {
  photos: PhotoModel[];
}

const OFF_TOPIC_PHOTO_ID = 'ev10';
const OFF_TOPIC_POSITION = 4;
const TALL_POSITION = 0;
const WIDE_POSITION = 3;

const { photos } = Astro.props;

const arranged = photos.filter((photo) => photo.id !== OFF_TOPIC_PHOTO_ID);
const offTopic = photos.find((photo) => photo.id === OFF_TOPIC_PHOTO_ID);
if (offTopic) {
  arranged.splice(Math.min(OFF_TOPIC_POSITION, arranged.length), 0, offTopic);
}

const shapeOf = (index: number) => {
  if (index === TALL_POSITION) return 'dense-tall';
  if (index === WIDE_POSITION) return 'dense-wide';
  return undefined;
};
---
<h2 class="sr-only">Galería</h2>
<div class="dense-gallery">
  {arranged.map((photo, index) => (
    <figure class:list={['dense-item', shapeOf(index)]} data-reveal>
      <Photo
        photo={photo}
        priority={index === 0}
        sizes={index === 0 ? '(min-width: 768px) 30vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
      />
    </figure>
  ))}
</div>

<style>
  .dense-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(160px, 20vw, 320px);
    grid-auto-flow: dense;
    gap: var(--gap-photo);
  }

  .dense-item {
    margin: 0;
    min-height: 0;
  }

  .dense-item :global(.photo),
  .dense-item :global(img) {
    width: 100%;
    height: 100%;
  }

  .dense-tall {
    grid-row: span 2;
  }

  .dense-wide {
    grid-column: span 2;
  }

  .dense-wide :global(img) {
    object-position: 50% 20% !important;
  }

  @media (min-width: 700px) {
    .dense-gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .dense-gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
