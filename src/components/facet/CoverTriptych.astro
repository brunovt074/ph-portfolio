---
import Photo from '@/components/Photo.astro';
import type { Photo as PhotoModel } from '@/domain/Photo';

interface Props {
  photos: PhotoModel[];
}

const { photos } = Astro.props;
const [main, ...rest] = photos;
const side = rest.slice(0, 2);
---
{main && (
  <div class="container">
  <div class="cover-triptych">
    <div class="cover-main" data-reveal>
      <Photo photo={main} ratio="4/5" priority sizes="(min-width: 768px) 66vw, 100vw" />
    </div>
    <div class="cover-side">
      {side.map((photo) => (
        <div class="cover-side-item" data-reveal>
          <Photo photo={photo} sizes="(min-width: 768px) 33vw, 50vw" />
        </div>
      ))}
    </div>
  </div>
  </div>
)}

<style>
  .cover-triptych {
    display: grid;
    gap: var(--gap-photo);
  }

  .cover-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-photo);
  }

  .cover-side-item {
    aspect-ratio: 3 / 4;
  }

  .cover-side-item :global(.photo),
  .cover-side-item :global(img) {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 768px) {
    .cover-triptych {
      grid-template-columns: 2fr 1fr;
      align-items: stretch;
    }

    .cover-main {
      min-width: 0;
    }

    .cover-side {
      display: flex;
      flex-direction: column;
      min-height: 0;
      position: relative;
    }

    .cover-side-item {
      flex: 1;
      min-height: 0;
      aspect-ratio: auto;
    }
  }
</style>
