---
import type { Service } from '@/domain/Service';

interface Props {
  title: string;
  services: Service[];
  numerals: 'roman' | 'none';
  bookingLinks?: Record<string, string>;
  bookingLabel?: string;
}

const { title, services, numerals, bookingLinks = {}, bookingLabel = '' } = Astro.props;
const romans = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.'];
---
<section class="container section service-columns">
  <h2 class="t-h2">{title}</h2>
  <ul class="service-list">
    {services.map((service, index) => (
      <li class="service">
        {numerals === 'roman' && <span class="service-numeral t-numeral" aria-hidden="true">{romans[index]}</span>}
        <h3 class="t-h3">{service.title}</h3>
        {service.description && <p class="service-description">{service.description}</p>}
        {service.price && (
          <p class="service-price">
            <span class="t-eyebrow">Inversión</span>
            <span class="service-price-value">{service.price}</span>
          </p>
        )}
        {Object.hasOwn(bookingLinks, service.title) && (
          <a class="service-booking" href={bookingLinks[service.title]}>{bookingLabel}<span class="sr-only"> — {service.title}</span></a>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .service-columns {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }

  .service-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: clamp(24px, 4vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 480px) {
    .service-list:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .service-list:has(> :nth-child(4):last-child) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .service-numeral {
    color: var(--accent-current);
  }

  .service-description {
    margin: 0;
    color: var(--fg-soft);
  }

  .service-price {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: auto 0 0;
    padding-top: 12px;
  }

  .service-booking {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    width: fit-content;
    color: var(--accent-current);
    font-weight: 600;
  }

  .service-price-value {
    font-weight: 600;
  }
</style>
