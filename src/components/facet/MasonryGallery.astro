---
import LightboxLink from '@/components/LightboxLink.astro';
import Photo from '@/components/Photo.astro';
import type { Photo as PhotoModel } from '@/domain/Photo';
import type { SiteTexts } from '@/domain/SiteTexts';
import { sanityAspect } from '@/infrastructure/sanity/imageUrl';
import { resolveLocalPhoto } from '@/infrastructure/images/localPhotos';

interface Props {
  photos: PhotoModel[];
  texts: SiteTexts['pages'];
  horizontal?: boolean;
}

const { photos, horizontal = false, texts } = Astro.props;

const FALLBACK_ASPECT = 1.25;

const aspectOf = (photo: PhotoModel) => {
  if (photo.asset.provider !== 'local') {
    const aspect = sanityAspect(photo);
    return aspect ? 1 / aspect : FALLBACK_ASPECT;
  }
  const { image } = resolveLocalPhoto(photo.asset.ref);
  return image.height / image.width;
};

const EXHAUSTIVE_LIMIT = 4_000_000;

const aspects = photos.map(aspectOf);

const greedyAssignment = (columnCount: number) => {
  const heights: number[] = Array.from({ length: columnCount }, () => 0);
  return aspects.map((aspect) => {
    const target = heights.indexOf(Math.min(...heights));
    heights[target] = (heights[target] ?? 0) + aspect;
    return target;
  });
};

const spreadOf = (assignment: number[], columnCount: number) => {
  const heights: number[] = Array.from({ length: columnCount }, () => 0);
  assignment.forEach((target, index) => {
    heights[target] = (heights[target] ?? 0) + (aspects[index] ?? 0);
  });
  return Math.max(...heights) - Math.min(...heights);
};

const bestAssignment = (columnCount: number) => {
  let best = greedyAssignment(columnCount);
  if (columnCount ** Math.max(photos.length - 1, 0) > EXHAUSTIVE_LIMIT) return best;
  let bestSpread = spreadOf(best, columnCount);
  const current: number[] = [];
  const search = (index: number) => {
    if (index === photos.length) {
      const spread = spreadOf(current, columnCount);
      if (spread < bestSpread) {
        bestSpread = spread;
        best = [...current];
      }
      return;
    }
    const lastColumn = index === 0 ? 1 : columnCount;
    for (let column = 0; column < lastColumn; column++) {
      current[index] = column;
      search(index + 1);
    }
  };
  search(0);
  return best;
};

const distribute = (columnCount: number) => {
  const assignment = bestAssignment(columnCount);
  const columns: PhotoModel[][] = Array.from({ length: columnCount }, () => []);
  photos.forEach((photo, index) => columns[assignment[index] ?? 0]?.push(photo));
  return columns;
};

const layouts = [
  { name: 'wide', columns: distribute(3), sizes: horizontal ? '(min-width: 1024px) 50vw, (min-width: 900px) 33vw, 100vw' : '(min-width: 900px) 33vw, 100vw' },
  { name: 'narrow', columns: distribute(2), sizes: '(min-width: 600px) 50vw, 50vw' },
];
---
<h2 class="sr-only">{texts.gallery}</h2>
<div class="gallery-track" data-lightbox-group>
  {layouts.map((layout) => (
    <div class={`masonry-cols masonry-${layout.name}`}>
      {layout.columns.map((column) => (
        <div class="masonry-col">
          {column.map((photo) => (
            <figure class="masonry-item" data-reveal>
              <LightboxLink photo={photo}>
                <Photo photo={photo} sizes={layout.sizes} />
              </LightboxLink>
            </figure>
          ))}
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .masonry-cols {
    display: flex;
    gap: var(--gap-photo);
  }

  .masonry-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-photo);
  }

  .masonry-item {
    margin: 0;
  }

  .masonry-item :global(img) {
    width: 100%;
    height: auto;
  }

  .masonry-wide {
    display: none;
  }

  :global([data-gallery='horizontal'].is-horizontal) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    min-height: 100svh;
    max-width: none;
    padding-block: 0;
    overflow-x: clip;
  }

  :global(.is-horizontal) .masonry-narrow {
    display: none;
  }

  :global(.is-horizontal) .masonry-wide {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--gap-photo);
    align-items: center;
    width: max-content;
    height: 78vh;
  }

  :global(.is-horizontal) .masonry-wide .masonry-col {
    display: contents;
  }

  :global(.is-horizontal) .masonry-wide .masonry-item {
    flex: 0 0 auto;
    height: 100%;
    width: auto;
  }

  :global(.is-horizontal) .masonry-wide :global(.lightbox-link),
  :global(.is-horizontal) .masonry-wide :global(.photo) {
    height: 100%;
    width: auto;
  }

  :global(.is-horizontal) .masonry-wide .masonry-item :global(img) {
    height: 100%;
    width: auto;
    max-width: none;
  }

  @media (min-width: 900px) {
    .masonry-wide {
      display: flex;
    }

    .masonry-narrow {
      display: none;
    }
  }
</style>

<script>
  import { afterLoad } from '@/motion/afterLoad';
  afterLoad(() => import('@/motion/horizontalGallery'));
</script>
