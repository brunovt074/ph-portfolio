---
import LightboxLink from '@/components/LightboxLink.astro';
import Photo from '@/components/Photo.astro';
import type { Photo as PhotoModel } from '@/domain/Photo';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  photos: PhotoModel[];
  texts: SiteTexts['pages'];
  ratio: string;
}

const { photos, ratio, texts } = Astro.props;
---
<h2 class="sr-only">{texts.gallery}</h2>
<div class="grid-gallery" data-lightbox-group>
  {photos.map((photo) => (
    <figure class="grid-gallery-item" data-reveal>
      <LightboxLink photo={photo}>
        <Photo photo={photo} ratio={ratio} sizes="(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw" />
      </LightboxLink>
    </figure>
  ))}
</div>

<style>
  .grid-gallery {
    --cols: 2;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap-photo);
  }

  .grid-gallery-item {
    margin: 0;
  }

  @media (min-width: 1100px) {
    .grid-gallery {
      --cols: 4;
    }
  }
</style>
