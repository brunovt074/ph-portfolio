---
import Photo from '@/components/Photo.astro';
import type { Photo as PhotoModel } from '@/domain/Photo';

interface Props {
  photos: PhotoModel[];
  ratio: string;
}

const { photos, ratio } = Astro.props;
---
<h2 class="sr-only">Galería</h2>
<div class="grid-gallery">
  {photos.map((photo) => (
    <figure class="grid-gallery-item" data-reveal>
      <Photo photo={photo} ratio={ratio} sizes="(min-width: 1100px) 25vw, (min-width: 768px) 33vw, 50vw" />
    </figure>
  ))}
</div>

<style>
  .grid-gallery {
    --cols: 2;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap-photo);
  }

  .grid-gallery-item {
    margin: 0;
  }

  @media (min-width: 1100px) {
    .grid-gallery {
      --cols: 4;
    }
  }
</style>
