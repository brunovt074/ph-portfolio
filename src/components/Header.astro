---
import Arrow from '@/components/Arrow.astro';
import Button from './Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { navigationLinks } from './navigationLinks';
import type { HeaderVariant } from './navigationLinks';
import type { Locale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  locale: Locale;
  texts: SiteTexts;
  alternates: Record<Locale, string>;
  variant?: HeaderVariant;
  current?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { locale, texts, alternates, variant = 'site', current = 'home', ctaLabel, ctaHref } = Astro.props;

const links = navigationLinks(variant, locale, texts);
const resolvedCtaLabel = ctaLabel ?? (variant === 'site' ? texts.nav.bookSession : undefined);
const resolvedCtaHref = ctaHref ?? (variant === 'site' ? pathTo(locale, { route: 'reservas' }) : undefined);
const cta = resolvedCtaLabel && resolvedCtaHref ? { label: resolvedCtaLabel, href: resolvedCtaHref } : undefined;
const currentHref = links.find((link) => link.key === current)?.href;
const navLabel = variant === 'obra' ? texts.a11y.obraNav : texts.a11y.mainNav;
---
<header class="site-header">
  <div class="container site-header-row">
    <Logo variant={variant === 'obra' ? 'obra' : 'default'} locale={locale} texts={texts.nav} />
    <nav class="site-nav" aria-label={navLabel}>
      {links.map((link) => (
        <a
          class:list={['t-nav', 'site-nav-link', link.muted && 'site-nav-muted']}
          href={link.href}
          aria-current={link.key === current ? 'page' : undefined}
        >
          {link.label}{link.muted && <Arrow direction="up-right" />}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <span class="header-switcher"><LanguageSwitcher locale={locale} alternates={alternates} label={texts.a11y.languageSwitcher} /></span>
      <MobileMenu links={links} locale={locale} alternates={alternates} texts={texts.a11y} {...(cta ? { ctaLabel: cta.label, ctaHref: cta.href } : {})} current={currentHref} />
      {cta && <Button class="header-cta" href={cta.href} variant="primary">{cta.label}</Button>}
    </div>
  </div>
</header>
<button class="back-to-top" type="button" aria-label={texts.a11y.backToTop} data-back-to-top data-visible="false"><Arrow direction="up" /></button>

<style>
  :global(html.js) .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .site-header {
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  :global(html.js) .site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  .back-to-top {
    position: fixed;
    right: var(--gutter);
    bottom: clamp(16px, 3vh, 32px);
    z-index: 30;
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    font-size: 18px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
  }

  .back-to-top[data-visible='true'] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .back-to-top {
      transition: opacity 0.3s ease, visibility 0.3s;
    }
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(body:has([data-series-counter])) .back-to-top {
    bottom: calc(clamp(16px, 3vh, 32px) + 48px);
  }

  :global(html:not(.js)) .back-to-top {
    display: none;
  }

  .site-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
    min-height: var(--header-h);
  }

  .site-nav {
    display: flex;
    gap: 4px;
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav::-webkit-scrollbar {
    display: none;
  }

  :global(html:not(.js)) .site-nav {
    flex-wrap: wrap;
    overflow: visible;
  }

  .site-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 12px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav-muted {
    color: var(--fg-muted);
  }

  .site-nav-link[aria-current='page'] {
    color: var(--accent-current);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px 16px;
    margin-left: auto;
    order: 2;
  }

  @media (min-width: 900px) {
    .site-nav {
      order: 2;
      flex-basis: auto;
      overflow: visible;
    }

    .header-actions {
      order: 3;
    }
  }

  @media (max-width: 899px) {
    :global(html.js) .site-nav,
    :global(html.js) .header-switcher {
      display: none;
    }
  }

  @media (max-width: 599px) {
    :global(html.js) :global(.header-cta) {
      display: none;
    }
  }
</style>
