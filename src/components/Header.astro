---
import Arrow from '@/components/Arrow.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import type { Locale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';
import type { SiteTexts } from '@/domain/SiteTexts';
import Button from './Button.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { navigationLinks } from './navigationLinks';
import type { HeaderVariant } from './navigationLinks';

interface Props {
  variant?: HeaderVariant;
  current?: string;
  ctaLabel?: string;
  ctaHref?: string;
  locale: Locale;
  texts: SiteTexts;
  alternates: Record<Locale, string>;
}

const { variant = 'site', current = 'home', ctaLabel, ctaHref, locale, texts, alternates } = Astro.props;

const links = navigationLinks(variant, locale, texts);
const resolvedCtaLabel = ctaLabel ?? (variant === 'site' ? texts.nav.bookSession : undefined);
const resolvedCtaHref = ctaHref ?? (variant === 'site' ? pathTo(locale, { route: 'reservas' }) : undefined);
const cta = resolvedCtaLabel && resolvedCtaHref ? { label: resolvedCtaLabel, href: resolvedCtaHref } : undefined;
const currentHref = links.find((link) => link.key === current)?.href;
const navLabel = variant === 'obra' ? texts.a11y.obraNav : texts.a11y.mainNav;
---
<header class="site-header">
  <div class="container site-header-row">
    <Logo variant={variant === 'obra' ? 'obra' : 'default'} locale={locale} texts={texts} />
    <nav class="site-nav" aria-label={navLabel}>
      {links.map((link) => (
        <a
          class:list={['t-nav', 'site-nav-link', link.muted && 'site-nav-muted']}
          href={link.href}
          aria-current={link.key === current ? 'page' : undefined}
        >
          {link.label}{link.muted && <Arrow direction="up-right" />}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <LanguageSwitcher locale={locale} alternates={alternates} label={texts.a11y.languageSwitcher} />
      <MobileMenu
        links={links}
        texts={texts.a11y}
        locale={locale}
        alternates={alternates}
        {...(cta ? { ctaLabel: cta.label, ctaHref: cta.href } : {})}
        current={currentHref}
      />
      {cta && <Button class="header-cta" href={cta.href} variant="primary">{cta.label}</Button>}
    </div>
  </div>
</header>

<style>
  .site-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
    min-height: var(--header-h);
  }

  .site-nav {
    display: flex;
    gap: 4px;
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav::-webkit-scrollbar {
    display: none;
  }

  :global(html:not(.js)) .site-nav {
    flex-wrap: wrap;
    overflow: visible;
  }

  .site-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 12px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav-muted {
    color: var(--fg-muted);
  }

  .site-nav-link[aria-current='page'] {
    color: var(--accent-current);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px 16px;
    margin-left: auto;
    order: 2;
  }

  @media (min-width: 900px) {
    .site-nav {
      order: 2;
      flex-basis: auto;
      overflow: visible;
    }

    .header-actions {
      order: 3;
    }
  }

  @media (max-width: 899px) {
    :global(html.js) .site-nav {
      display: none;
    }
  }

  @media (max-width: 599px) {
    :global(html.js) :global(.header-cta) {
      display: none;
    }
  }
</style>
