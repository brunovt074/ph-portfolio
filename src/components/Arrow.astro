---
interface Props {
  direction: 'right' | 'left' | 'up-right';
}

const { direction } = Astro.props;
const shapes = {
  right: 'M1.5 8H14.5M9 2.5L14.5 8L9 13.5',
  left: 'M14.5 8H1.5M7 2.5L1.5 8L7 13.5',
  'up-right': 'M2.5 13.5L13.5 2.5M5.5 2.5H13.5V10.5',
};
---
<svg class:list={['arrow', `arrow-${direction}`]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d={shapes[direction]} />
</svg>

<style>
  .arrow {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }

  .arrow-up-right {
    width: 0.8em;
    height: 0.8em;
    margin-left: 0.25em;
  }
</style>
