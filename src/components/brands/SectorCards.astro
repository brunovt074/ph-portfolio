---
import Photo from '@/components/Photo.astro';
import type { BrandSector } from '@/domain/BrandSector';

interface Props {
  title: string;
  sectors: BrandSector[];
}

const { title, sectors } = Astro.props;
---
<section class="container section sectors">
  <h2 class="t-h2">{title}</h2>
  <div class="grid">
    {sectors.map((sector, index) => (
      <figure data-reveal>
        <Photo
          photo={sector.photo}
          ratio="4/5"
          priority={index === 0}
          sizes="(min-width: 1200px) 24vw, (min-width: 600px) 45vw, 100vw"
        />
        <figcaption>
          <h3 class="t-h3">{sector.title}</h3>
          <p>{sector.description}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .sectors {
    padding-top: clamp(24px, 3vw, 40px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(28px, 4vw, 56px);
  }

  figure {
    margin: 0;
  }

  figcaption {
    padding-top: 16px;
  }

  figcaption p {
    margin: 8px 0 0;
    color: var(--fg-muted);
    font-size: var(--text-small);
  }
</style>
