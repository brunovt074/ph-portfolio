---
import Photo from '@/components/Photo.astro';
import type { BrandSector } from '@/domain/BrandSector';

interface Props {
  title: string;
  sectors: BrandSector[];
}

const { title, sectors } = Astro.props;
---
<section class="container section sectors">
  <h2 class="t-h2">{title}</h2>
  <div class="grid">
    {sectors.map((sector, index) => (
      <figure data-reveal>
        <Photo
          photo={sector.photo}
          ratio="4/5"
          priority={index === 0}
          sizes="(min-width: 1100px) 24vw, 46vw"
        />
        <figcaption>
          <h3 class="t-h3">{sector.title}</h3>
          <p>{sector.description}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .sectors {
    padding-top: clamp(24px, 3vw, 40px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(12px, 2vw, 24px);
    margin-top: clamp(28px, 4vw, 56px);
  }

  figure {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    margin: 0 0 clamp(24px, 3vw, 40px);
  }

  figcaption {
    display: contents;
  }

  figcaption h3 {
    padding-top: 16px;
    font-size: var(--text-small);
    line-height: 1.15;
  }

  figcaption p {
    margin: 8px 0 0;
    color: var(--fg-muted);
    font-size: var(--text-small);
  }

  @media (min-width: 600px) {
    .grid {
      column-gap: clamp(16px, 2vw, 24px);
    }

    figcaption h3 {
      font-size: var(--text-h3);
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
