---
import Button from '@/components/Button.astro';
import type { BrandPackage } from '@/domain/BrandPackage';

interface Props {
  pack: BrandPackage;
  cta: string;
}

const { pack, cta } = Astro.props;
const FEATURED_LABEL = 'Más elegido';
const [amount = pack.price, ...suffixParts] = pack.price.split(' / ');
const suffix = suffixParts.join(' / ');
---
<article class="card" data-theme={pack.featured ? 'paper' : undefined}>
  {pack.featured ? (
    <span class="t-eyebrow">{FEATURED_LABEL}</span>
  ) : (
    <span class="t-eyebrow eyebrow-spacer" aria-hidden="true">{FEATURED_LABEL}</span>
  )}
  <h3 class="t-h3">{pack.name}</h3>
  <p class="price">
    <span class="price-amount">{amount}</span>
    {suffix && <span class="price-suffix">/ {suffix}</span>}
  </p>
  <ul>
    {pack.items.map((item) => <li>{item}</li>)}
  </ul>
  <Button class="cta" href="/?tipo=marcas#contacto" variant={pack.featured ? 'primary' : 'secondary'}>{cta}</Button>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
  }

  .eyebrow-spacer {
    display: none;
    visibility: hidden;
  }

  .price {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.3em;
    min-width: 0;
  }

  .price-amount,
  .price-suffix {
    white-space: nowrap;
  }

  .price-suffix {
    font-size: var(--text-h3);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    align-content: start;
    gap: 12px;
    color: var(--fg-soft);
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
  }

  li::before {
    content: '—';
    color: var(--fg-muted);
  }

  .card :global(.cta) {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (min-width: 900px) {
    .card {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 20px;
    }

    .eyebrow-spacer {
      display: block;
    }

    .card :global(.cta) {
      align-self: end;
      justify-self: start;
    }
  }
</style>
