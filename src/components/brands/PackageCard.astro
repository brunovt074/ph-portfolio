---
import Button from '@/components/Button.astro';
import type { BrandPackage } from '@/domain/BrandPackage';
import type { Locale } from '@/domain/Locale';
import type { SiteTexts } from '@/domain/SiteTexts';
import { pathTo } from '@/domain/routing/pathTo';

interface Props {
  locale: Locale;
  texts: SiteTexts['pages'];
  pack: BrandPackage;
  cta: string;
}

const { locale, texts, pack, cta } = Astro.props;
const [amount = pack.price, ...suffixParts] = pack.price.split(' / ');
const suffix = suffixParts.join(' / ');
---
<article class="card" data-theme={pack.featured ? 'paper' : undefined}>
  {pack.featured ? (
    <span class="t-eyebrow">{texts.featuredPackage}</span>
  ) : (
    <span class="t-eyebrow eyebrow-spacer" aria-hidden="true">{texts.featuredPackage}</span>
  )}
  <h3 class="t-h3">{pack.name}</h3>
  <p class="price">
    <span class="price-amount">{amount}</span>
    {suffix && <span class="price-suffix">/ {suffix}</span>}
  </p>
  <ul>
    {pack.items.map((item) => <li>{item}</li>)}
  </ul>
  <Button class="cta" href={pathTo(locale, { route: 'home', query: { tipo: 'marcas' }, hash: 'contacto' })} variant={pack.featured ? 'primary' : 'secondary'}>{cta}</Button>
</article>

<style>
  .card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--line);
  }

  .eyebrow-spacer {
    display: none;
    visibility: hidden;
  }

  .price {
    margin: 0;
    font-family: var(--font-display);
    font-size: min(var(--text-h2), 17cqi);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    white-space: nowrap;
    min-width: 0;
  }

  .price-suffix {
    margin-left: 0.3em;
    font-family: var(--font-body);
    font-size: 0.4em;
    font-weight: 500;
    letter-spacing: normal;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    align-content: start;
    gap: 12px;
    color: var(--fg-soft);
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
  }

  li::before {
    content: '—';
    color: var(--fg-muted);
  }

  .card :global(.cta) {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (min-width: 900px) {
    .card {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 20px;
    }

    .eyebrow-spacer {
      display: block;
    }

    .card :global(.cta) {
      align-self: end;
      justify-self: start;
    }
  }
</style>
