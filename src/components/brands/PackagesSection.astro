---
import type { BrandPackage } from '@/domain/BrandPackage';
import type { Locale } from '@/domain/Locale';
import type { SiteTexts } from '@/domain/SiteTexts';
import PackageCard from './PackageCard.astro';

interface Props {
  locale: Locale;
  texts: SiteTexts['pages'];
  title: string;
  cta: string;
  packages: BrandPackage[];
}

const { locale, texts, title, cta, packages } = Astro.props;
const ordered = [...packages].sort((a, b) => a.order - b.order);
---
<section data-theme="ink" class="section">
  <div class="container">
    <h2 class="t-h2">{title}</h2>
    <div class="grid">
      {ordered.map((pack) => <PackageCard locale={locale} texts={texts} pack={pack} cta={cta} />)}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(28px, 4vw, 56px);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 0;
    }
  }
</style>
