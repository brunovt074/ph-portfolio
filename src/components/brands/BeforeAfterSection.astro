---
import { getImage } from 'astro:assets';
import RichText from '@/components/RichText.astro';
import type { BeforeAfterPair } from '@/domain/BeforeAfterPair';
import type { RichTitle } from '@/domain/RichTitle';
import type { Photo } from '@/domain/Photo';
import { sanityPhotoUrl } from '@/infrastructure/sanity/imageUrl';
import { resolveLocalPhoto } from '@/infrastructure/images/localPhotos';
import BeforeAfterSlider from '@/islands/BeforeAfterSlider';

interface Props {
  title: RichTitle;
  lead: string;
  pairs: BeforeAfterPair[];
}

const { title, lead, pairs } = Astro.props;

const optimize = async (photo: Photo) => {
  if (photo.asset.provider !== 'local') {
    const width = Math.min(1200, photo.asset.width ?? 1200);
    const height = photo.asset.width && photo.asset.height ? Math.round((width * photo.asset.height) / photo.asset.width) : 1500;
    return { src: sanityPhotoUrl(photo, width), width, height };
  }
  const optimized = await getImage({ src: resolveLocalPhoto(photo.asset.ref).image, width: 1200, format: 'webp' });
  return {
    src: optimized.src,
    width: Number(optimized.attributes.width),
    height: Number(optimized.attributes.height),
  };
};

const sliders = await Promise.all(
  pairs.map(async (pair) => {
    const [before, after] = await Promise.all([optimize(pair.before), optimize(pair.after)]);
    return {
      beforeSrc: before.src,
      afterSrc: after.src,
      alt: pair.alt,
      width: after.width,
      height: after.height,
      provisional: pair.provisional,
    };
  }),
);
---
<section class="container section compare">
  <div class="intro">
    <h2 class="t-h2"><RichText title={title} /></h2>
    <p class="t-lead">{lead}</p>
  </div>
  <div class="sliders">
    {sliders.map((slider) => (
      <div data-reveal>
        <BeforeAfterSlider client:visible {...slider} />
      </div>
    ))}
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 20px;
    justify-items: center;
    text-align: center;
  }

  .intro :global(em) {
    color: var(--accent-current);
  }

  .sliders {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    margin-top: clamp(28px, 4vw, 56px);
  }

  .sliders :global(.ba) {
    margin: 0;
  }

  .sliders :global(.ba-frame) {
    --knob-half: calc(var(--tap) / 2);
    position: relative;
    max-width: min(100%, 45rem);
    margin-inline: auto;
    overflow: hidden;
    touch-action: pan-y;
  }

  .sliders :global(.ba-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    pointer-events: none;
  }

  .sliders :global(.ba-before) {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .sliders :global(.ba-provisional) {
    filter: saturate(0.35) contrast(0.82) brightness(1.06);
  }

  .sliders :global(.ba-label) {
    position: absolute;
    top: 0.75rem;
    padding: 0.4rem 0.6rem;
    background: var(--door-label-bg);
    color: var(--paper);
    pointer-events: none;
  }

  .sliders :global(.ba-label-before) {
    left: 0.75rem;
  }

  .sliders :global(.ba-label-after) {
    right: 0.75rem;
  }

  .sliders :global(.ba-divider) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 0.125rem;
    margin-left: -0.0625rem;
    background: var(--paper);
    pointer-events: none;
  }

  .sliders :global(.ba-knob) {
    position: absolute;
    top: 50%;
    left: clamp(var(--knob-half), var(--pos), calc(100% - var(--knob-half)));
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: var(--text-lead);
    line-height: 1;
    pointer-events: none;
  }

  .sliders :global(.ba-frame:has(input:focus-visible) .ba-knob) {
    outline: 2px solid var(--accent-current);
    outline-offset: 3px;
  }

  .sliders :global(.ba-range) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .sliders :global(.ba-note) {
    max-width: min(100%, 45rem);
    margin: 0.75rem auto 0;
    color: var(--fg-muted);
    font-size: var(--text-small);
    text-align: center;
  }
</style>
