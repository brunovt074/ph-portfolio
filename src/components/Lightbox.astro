---
import Arrow from '@/components/Arrow.astro';
import type { SiteTexts } from '@/domain/SiteTexts';

interface Props {
  texts: SiteTexts['a11y'];
}

const { texts } = Astro.props;
---
<dialog class="lightbox" aria-label={texts.lightbox} data-lightbox-dialog>
  <div class="lightbox-stage" data-lightbox-stage>
    <img class="lightbox-image" alt="" data-lightbox-image />
  </div>
  <button type="button" class="t-nav lightbox-button lightbox-close" data-lightbox-close>{texts.lightboxClose}</button>
  <button type="button" class="t-nav lightbox-button lightbox-previous" data-lightbox-previous aria-label={texts.lightboxPrevious}><Arrow direction="left" /></button>
  <button type="button" class="t-nav lightbox-button lightbox-next" data-lightbox-next aria-label={texts.lightboxNext}><Arrow direction="right" /></button>
</dialog>

<style is:global>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100svh;
    max-height: none;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--ink) 96%, transparent);
    color: var(--paper);
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .lightbox-image {
    max-width: 92vw;
    max-height: 88svh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox-button {
    position: absolute;
    min-width: var(--tap);
    min-height: var(--tap);
    padding-inline: 12px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .lightbox-close {
    top: 12px;
    right: var(--gutter);
  }

  .lightbox-previous {
    left: var(--gutter);
    bottom: 12px;
  }

  .lightbox-next {
    right: var(--gutter);
    bottom: 12px;
  }

  .lightbox-button[hidden] {
    display: none;
  }

  ::view-transition-group(lv-photo) {
    animation-duration: 0.6s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
</style>

<script>
  import { afterLoad } from '@/motion/afterLoad';
  afterLoad(() => import('@/motion/lightbox'));
</script>
