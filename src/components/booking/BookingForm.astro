---
import type { BookingOfferView } from '@/application/results/BookingOfferView';
import type { Locale } from '@/domain/Locale';
import { pathTo } from '@/domain/routing/pathTo';
import type { SiteTexts } from '@/domain/SiteTexts';
import { getBookingCatalog } from '@/infrastructure/getBookingCatalog';
import { localeTagOf } from '@/formatting/localeTag';
import CustomerFields from './CustomerFields.astro';
import PaymentStep from './PaymentStep.astro';
import SchedulePanel from './SchedulePanel.astro';
import SessionCards from './SessionCards.astro';

interface Props {
  offers: BookingOfferView[];
  texts: SiteTexts['booking'];
  locale: Locale;
  timeZone: string;
}

const { offers, texts, locale, timeZone } = Astro.props;
const hasSlotSessions = offers.some((offer) => offer.bookable && offer.scheduling === 'slots');
const firstBookable = offers.find((offer) => offer.bookable);
const { horizonDays } = await getBookingCatalog().content.getSchedulingSettings();
const contactHref = pathTo(locale, { route: 'home', query: { tipo: 'retratos' }, hash: 'contacto' });
---
{firstBookable ? (
  <form
    id="reserva"
    class="booking-form"
    method="post"
    action="/reservas/iniciar"
    novalidate
    aria-label={texts.formLabel}
    data-booking-form
    data-texts={JSON.stringify(texts)}
    data-time-zone={timeZone}
    data-locale-tag={localeTagOf(locale)}
    data-horizon-days={horizonDays}
    data-slots-endpoint="/api/bookings/slots"
  >
    <SessionCards offers={offers} texts={texts} locale={locale} />
    <SchedulePanel texts={texts} hasSlotSessions={hasSlotSessions} locale={locale} />
    <CustomerFields texts={texts} />
    <PaymentStep texts={texts} depositPercent={firstBookable.depositPercent} conditionsHref={`${pathTo(locale, { route: 'reservas' })}#condiciones`} />
  </form>
) : (
  <section id="reserva" class="booking-form" aria-label={texts.formLabel}>
    <SessionCards offers={offers} texts={texts} locale={locale} />
    <p class="no-offers">{texts.noOffersLead} <a href={contactHref}>{texts.unavailableLink}</a></p>
  </section>
)}

<style>
  .booking-form {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
    min-width: 0;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .no-offers {
    margin: 0;
    color: var(--fg-soft);
  }
</style>

<script>
  import { afterLoad } from '@/motion/afterLoad';

  const startForms = () => import('@/forms/booking/initBookingForms').then(({ initBookingForms }) => initBookingForms());

  afterLoad(startForms);
  document.addEventListener('astro:page-load', startForms);
</script>
