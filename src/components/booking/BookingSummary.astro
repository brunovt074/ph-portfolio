---
import type { BookingStatusView } from '@/application/results/BookingStatusView';
import type { SiteTexts } from '@/domain/SiteTexts';
import { buildSummaryRows } from './buildSummaryRows';

interface Props {
  view: BookingStatusView;
  texts: SiteTexts['booking'];
  localeTag: string;
  timeZone: string;
}

const { view, texts, localeTag, timeZone } = Astro.props;
const rows = buildSummaryRows(view, texts, localeTag, timeZone);
---
<dl class="summary" aria-label={texts.summaryLabel}>
  {rows.map((row) => (
    <div class="summary-row">
      <dt class="t-eyebrow">{row.label}</dt>
      <dd>{row.value}</dd>
    </div>
  ))}
</dl>

<style>
  .summary {
    display: grid;
    width: min(100%, 560px);
    margin: 0;
  }

  .summary-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }

  .summary-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  dd {
    margin: 0;
    font-weight: 600;
  }
</style>
