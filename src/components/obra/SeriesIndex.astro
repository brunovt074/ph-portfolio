---
import type { Locale } from '@/domain/Locale';
import type { Series } from '@/domain/Series';
import type { SiteTexts } from '@/domain/SiteTexts';
import SeriesChapter from './SeriesChapter.astro';

interface Props {
  locale: Locale;
  texts: SiteTexts['pages'];
  viewSeries: string;
  title: string;
  series: Series[];
}

const { locale, texts, viewSeries, title, series } = Astro.props;
---
<section id="series" class="series-index container" aria-labelledby="series-title">
  <h2 id="series-title" class="t-h2 series-heading">{title}</h2>
  <div class="series-chapters">
    {series.map((item, index) => <SeriesChapter locale={locale} texts={texts} viewSeries={viewSeries} series={item} index={index} />)}
  </div>
</section>

<style>
  .series-index {
    padding-bottom: calc(var(--section-y) * 1.5);
    scroll-margin-top: 24px;
  }

  .series-heading {
    padding-top: 24px;
    margin-bottom: calc(var(--section-y) * 0.75);
    border-top: 1px solid var(--line);
  }

  .series-chapters {
    display: grid;
    gap: calc(var(--section-y) * 1.5);
  }

  @media (max-width: 599px) {
    .series-chapters {
      gap: var(--section-y);
    }
  }
</style>
