---
import Arrow from '@/components/Arrow.astro';
import Photo from '@/components/Photo.astro';
import RichText from '@/components/RichText.astro';
import { formatText } from '@/domain/formatText';
import type { Locale } from '@/domain/Locale';
import type { Series } from '@/domain/Series';
import type { SiteTexts } from '@/domain/SiteTexts';
import { pathTo } from '@/domain/routing/pathTo';

interface Props {
  locale: Locale;
  texts: SiteTexts['pages'];
  viewSeries: string;
  series: Series;
  index: number;
}

const { locale, texts, viewSeries, series, index } = Astro.props;
const ratios = ['3/4', '1/1', '4/5', '3/4'];
const previewPhotos = series.photos.slice(0, 4);
const reversed = index % 2 === 1;
---
<article class:list={['chapter', { 'chapter-reversed': reversed }]}>
  <div class="chapter-text">
    <span class="chapter-numeral">{series.number}.</span>
    <h3 class="t-h2 chapter-title"><RichText title={series.displayTitle} /></h3>
    <p class="t-eyebrow">{formatText(texts.seriesCount, { count: series.photos.length, years: series.years })}</p>
    <p class="t-lead">{series.curatorialLine}</p>
    <a class="t-nav chapter-link" href={pathTo(locale, { route: 'serie', slug: series.slug })}>
      <span>{viewSeries}<span class="sr-only"> {series.title}</span></span>
      <span class="chapter-arrow" aria-hidden="true"><Arrow direction="right" /></span>
    </a>
  </div>
  <div class="chapter-photos">
    {previewPhotos.map((entry, position) => (
      <figure class="chapter-figure" data-reveal="darkroom">
        <Photo
          photo={entry.photo}
          ratio={ratios[position]}
          sizes="(min-width: 900px) 28vw, 46vw"
          transitionName={position === 0 ? `serie-${series.slug}-1` : undefined}
        />
      </figure>
    ))}
  </div>
</article>

<style>
  .chapter {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }

  .chapter-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .chapter-numeral {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--accent-current);
  }

  .chapter-title {
    margin-top: -4px;
  }

  .chapter-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    margin-top: 8px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 200ms;
  }

  .chapter-arrow {
    display: inline-block;
    transition: transform 200ms;
  }

  .chapter-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-photo);
    align-items: end;
  }

  .chapter-figure {
    margin: 0;
  }

  @media (hover: hover) {
    .chapter-link:hover {
      border-color: var(--accent-current);
    }

    .chapter-link:hover .chapter-arrow {
      transform: translateX(6px);
    }
  }

  @media (min-width: 900px) {
    .chapter {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 6vw, 120px);
    }

    .chapter-reversed {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .chapter-reversed .chapter-text {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-link,
    .chapter-arrow {
      transition: none;
    }
  }
</style>
