---
import Button from '@/components/Button.astro';
import RichText from '@/components/RichText.astro';
import type { ObraContent } from '@/domain/ObraContent';

interface Props {
  band: ObraContent['seriesPrintsBand'];
}

const { band } = Astro.props;
---
<section data-theme="ivory" class="prints-band">
  <div class="container prints-band-row">
    <h2 class="t-cta prints-band-title"><RichText title={band.title} /></h2>
    <Button href="/obra/copias" variant="primary">{band.cta}</Button>
  </div>
</section>

<style>
  .prints-band {
    padding-block: clamp(56px, 8vw, 112px);
  }

  .prints-band-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 48px;
  }

  .prints-band-title {
    max-width: 18ch;
  }
</style>
