---
import Button from '@/components/Button.astro';
import { formatText } from '@/domain/formatText';
import type { Locale } from '@/domain/Locale';
import type { Print } from '@/domain/Print';
import type { SiteTexts } from '@/domain/SiteTexts';
import { pathTo } from '@/domain/routing/pathTo';
import PassepartoutPhoto from './PassepartoutPhoto.astro';

interface Props {
  locale: Locale;
  texts: SiteTexts['pages'];
  print: Print;
  cta: string;
  editionLabel: string;
  priority?: boolean;
}

const { locale, texts, print, cta, editionLabel, priority = false } = Astro.props;
const title = print.photo.title ?? texts.untitled;
const edition =
  print.available === null
    ? formatText(texts.editionOnly, { edicion: print.edition })
    : formatText(editionLabel, { edicion: print.edition, disponibles: print.available });
const inquiryHref = pathTo(locale, { route: 'copias', query: { copia: title }, hash: 'consulta' });
---
<article class="print-card" data-reveal="darkroom">
  <PassepartoutPhoto photo={print.photo} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" priority={priority} />
  <div class="print-body">
    <h2 class="t-h3"><em>{title}</em></h2>
    <p class="t-eyebrow">{formatText(texts.printSeries, { number: print.series.number, title: print.series.title })}</p>
    <p class="print-edition">{edition}</p>
    <dl class="print-sizes">
      {print.sizes.map((size) => (
        <div class="print-size">
          <dt>{size.size}</dt>
          <dd>{size.price}</dd>
        </div>
      ))}
    </dl>
    <Button href={inquiryHref} variant="secondary">{cta}<span class="sr-only"> {title}</span></Button>
  </div>
</article>

<style>
  .print-card {
    display: grid;
    align-content: start;
    gap: 28px;
  }

  .print-body {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .print-edition {
    margin: 0;
    color: var(--fg-soft);
  }

  .print-sizes {
    width: 100%;
    margin: 6px 0 14px;
  }

  .print-size {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }

  .print-size:last-child {
    border-bottom: 1px solid var(--line);
  }

  .print-size dt,
  .print-size dd {
    margin: 0;
  }

  .print-size dd {
    color: var(--fg-muted);
  }
</style>
