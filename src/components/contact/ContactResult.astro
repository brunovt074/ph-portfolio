---
import FooterNav from '@/components/FooterNav.astro';
import Header from '@/components/Header.astro';
import Button from '@/components/Button.astro';
import RichText from '@/components/RichText.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GetSiteSettings } from '@/application/GetSiteSettings';
import { GetSiteTexts } from '@/application/GetSiteTexts';
import type { Locale } from '@/domain/Locale';
import { alternatePaths } from '@/domain/routing/alternatePaths';
import { contentRepository } from '@/infrastructure/container';
import { parseRichTitle } from '@/infrastructure/seed/parseRichTitle';

interface Props {
  title: string;
  lead: string;
  problems?: string[];
  backLabel: string;
  backHref: string;
  locale: Locale;
}

const { title, lead, problems = [], backLabel, backHref, locale } = Astro.props;
const richTitle = parseRichTitle(title);
const plainTitle = richTitle.map((segment) => segment.text).join('');
const [settings, texts] = await Promise.all([new GetSiteSettings(contentRepository).execute(locale), new GetSiteTexts(contentRepository).execute(locale)]);
const alternates = alternatePaths(() => ({ route: 'home' }));
---
<BaseLayout
  title={plainTitle}
  description={lead}
  theme="ink"
  noindex
  locale={locale}
  translations={{ es: true, en: false, pt: false }}
  alternates={alternates}
  skipLabel={texts.a11y.skipToContent}
>
  <Header slot="header" locale={locale} texts={texts} alternates={alternates} />
  <section class="section">
    <div class="container result">
      <h1 class="t-display" data-split><RichText title={richTitle} /></h1>
      <p class="t-lead">{lead}</p>
      {problems.length > 0 && (
        <ul class="result-problems">
          {problems.map((problem) => <li>{problem}</li>)}
        </ul>
      )}
      <Button href={backHref} variant="primary">{backLabel}</Button>
    </div>
  </section>
  <FooterNav slot="footer" previous={null} next={null} settings={settings} locale={locale} texts={texts} />
</BaseLayout>

<style>
  .result {
    display: grid;
    justify-items: start;
    gap: clamp(20px, 3vw, 32px);
    padding-block: var(--section-y);
  }

  .result h1 {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .result-problems {
    margin: 0;
    padding-left: 1.2em;
    color: var(--fg-soft);
  }
</style>
