---
import { locales } from '@/domain/Locale';
import type { Locale } from '@/domain/Locale';
import type { Translations } from '@/domain/Translations';
import type { SeoImage } from '@/seo/SeoImage';

interface Props {
  title: string;
  description: string;
  image?: SeoImage | undefined;
  noindex?: boolean;
  locale: Locale;
  translations: Translations;
  canonical?: string;
}

const { title, description, image, noindex = false, locale, translations, canonical } = Astro.props;
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogLocale: Record<Locale, string> = { es: 'es_AR', en: 'en_US', pt: 'pt_BR' };
const alternates = locales.filter((candidate) => candidate !== locale && translations[candidate]);
---
<link rel="canonical" href={resolvedCanonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Sarah Moreau" />
<meta property="og:locale" content={ogLocale[locale]} />
{alternates.map((candidate) => <meta property="og:locale:alternate" content={ogLocale[candidate]} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && (
  <>
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
  </>
)}
