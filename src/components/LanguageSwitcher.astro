---
import { enabledLocales, type Locale } from '@/domain/Locale';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  label: string;
}

const { locale, alternates, label } = Astro.props;
---
{enabledLocales.length > 1 && (
<nav class="language-switcher" aria-label={label}>
  {enabledLocales.map((code, index) => (
    <>
      {index > 0 && <span aria-hidden="true">·</span>}
      <a
        class="t-nav language-switcher-link"
        href={alternates[code]}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? 'true' : undefined}
      >{code.toUpperCase()}</a>
    </>
  ))}
</nav>
)}

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--fg-muted);
  }

  .language-switcher-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    color: inherit;
    text-decoration: none;
  }

  .language-switcher-link[aria-current='true'] {
    color: var(--accent-current);
  }
</style>
