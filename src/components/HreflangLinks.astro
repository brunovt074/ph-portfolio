---
import { locales } from '@/domain/Locale';
import type { Locale } from '@/domain/Locale';
import type { Translations } from '@/domain/Translations';

interface Props {
  alternates: Record<Locale, string>;
  translations: Translations;
  site: URL;
}

const { alternates, translations, site } = Astro.props;
const absolute = (path: string) => new URL(path, site).href;
const xDefault = translations.en ? alternates.en : alternates.es;
---
{locales.filter((locale) => translations[locale]).map((locale) => <link rel="alternate" hreflang={locale} href={absolute(alternates[locale])} />)}
<link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />
