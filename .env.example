PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_WRITE_TOKEN=

SITE_URL=https://laravischi.com
# true bloquea la indexación (robots.txt, noindex y sin sitemap). Dejarla vacía al lanzar el sitio.
BLOCK_INDEXING=

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_DELIVERY_MODE=

TRUST_PROXY=

# Reservas con seña (opcional hasta activar /reservar)
# Base de datos Postgres. Si queda vacía se usa una base embebida (PGlite) en PGLITE_DIR.
DATABASE_URL=
# Carpeta de la base embebida cuando no hay DATABASE_URL. Por defecto ./.data/pglite
PGLITE_DIR=
# Pasarela por defecto: mercadopago o simulado. Simulado es solo para desarrollo, nunca en producción.
PAYMENT_PROVIDER=mercadopago
# Credenciales de Mercado Pago (Checkout Pro) y secreto de firma de los webhooks.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Poné true para completar precios, duraciones y horarios de demostración (assets/booking-demo.json) donde el CMS no tenga datos. Solo desarrollo.
BOOKING_DEMO=

# Agenda con turnos
# Calendario de Lara: google o simulado (simulado es solo para desarrollo). Vacío: la clienta propone una fecha.
CALENDAR_PROVIDER=
# Google Calendar: id del calendario compartido con la cuenta de servicio (permiso "Hacer cambios en eventos").
GOOGLE_CALENDAR_ID=
# Email de la cuenta de servicio de Google Cloud.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio, entre comillas; los saltos de línea pueden ir como \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
